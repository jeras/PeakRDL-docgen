////////////////////////////////////////////////////////////////////////////////
// example memory map for 32-bit system bus
// TODO: add license
////////////////////////////////////////////////////////////////////////////////

// various reusable definitions
`include "fixed.rdl"
`include "float.rdl"

// example regfile-s
`include "example_fixed.rdl"
`include "example_simple.rdl"

// peripheral regfile-s
`include "gpio.rdl"
`include "uart.rdl"
`include "generic.rdl"

addrmap example32 #(
    longint unsigned REGWIDTH = 32
){
    name = "example32";
    desc = "Example for a 32-bit system bus, used for SystemRDL toolset testing.";

    // regwidth specifies the system bus width
    default regwidth = REGWIDTH;
    // accesswidth specifies the minimum width for read/write operations
    default accesswidth = REGWIDTH;

    GPIO #(.REGWIDTH (REGWIDTH), .WIDTH ( 8)) GPIO8;
    GPIO #(.REGWIDTH (REGWIDTH), .WIDTH (16)) GPIO16;
    GPIO #(.REGWIDTH (REGWIDTH), .WIDTH (24)) GPIO24;
    GPIO #(.REGWIDTH (REGWIDTH), .WIDTH (32)) GPIO32_1D [4];
    GPIO #(.REGWIDTH (REGWIDTH), .WIDTH (32)) GPIO32_2D [3][2];

    binary32 binary32_0d_a;
    binary32 binary32_0d_b;
    binary32 binary32_1d[4];
    binary32 binary32_2d[3][2];
    binary32 binary32_3d[2][3][5];

    configuration conf_0;
    control       ctrl_0;
    status        stat_0;
    configuration conf_1;
    control       ctrl_1;
    status        stat_1;
    configuration conf_2;
    control       ctrl_2;
    status        stat_2;
    configuration conf_3;
    control       ctrl_3;
    status        stat_3;

    fixed #(.REGWIDTH (REGWIDTH), .WIDTH (24)) DATATYPES;
};
